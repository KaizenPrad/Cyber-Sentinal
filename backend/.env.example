# REQUIRED — fill before `npm run dev`
# ── Server ──
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Neon Postgres (pooled connection string from https://console.neon.tech) ──
# e.g. postgresql://neondb_owner:xxxx@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Auth ──
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h

# Cookie name used for HttpOnly session JWT
TOKEN_COOKIE_NAME=cybersentinel-token
